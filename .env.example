# Copy to .env and fill in real values. Never commit .env.
# These are server-side settings only; never expose them to frontend code.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Local development only. Leave unset (off) in production.
DJANGO_DEBUG=true
# Production: your Railway domain.
# DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Supabase PostgreSQL.
# Supabase Dashboard > Connect > Session pooler > URI. URL-encode special
# characters in the password. Use the database password, NOT the
# service_role key or any other Supabase API key.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Alternatively, leave DATABASE_URL unset and use individual settings:
# DB_HOST=aws-0-YOUR_REGION.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_DB_PASSWORD

# TLS: require (default), verify-ca, or verify-full. Weaker modes are rejected
# except for localhost.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/prod-ca-2021.crt

# Seconds to keep connections open (0 closes after each request).
# DB_CONN_MAX_AGE=60

# Gemini API (server-side only). Create a key at https://aistudio.google.com/apikey.
# Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_ANSWER_MODEL=gemini-3.6-flash
# GEMINI_TRIAGE_MODEL=gemini-3.5-flash-lite
# Tried once if the answer model is overloaded or times out; empty disables it.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_TRIAGE_TIMEOUT_SECONDS=10
# GEMINI_ANSWER_TIMEOUT_SECONDS=20
# Questions per user per minute (protects the free-tier quota).
# CHAT_RATE_LIMIT_PER_MINUTE=10
